# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /app

# Copy solution and project files
COPY DevPulse.sln ./
COPY src/DevPulse.Domain/DevPulse.Domain.csproj src/DevPulse.Domain/
COPY src/DevPulse.Application/DevPulse.Application.csproj src/DevPulse.Application/
COPY src/DevPulse.Infrastructure/DevPulse.Infrastructure.csproj src/DevPulse.Infrastructure/
COPY src/DevPulse.Api/DevPulse.Api.csproj src/DevPulse.Api/
COPY tests/DevPulse.UnitTests/DevPulse.UnitTests.csproj tests/DevPulse.UnitTests/
COPY tests/DevPulse.IntegrationTests/DevPulse.IntegrationTests.csproj tests/DevPulse.IntegrationTests/

# Restore dependencies
RUN dotnet restore DevPulse.sln

# Copy entire source
COPY . .

# Publish API
WORKDIR /app/src/DevPulse.Api
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Runtime Stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "DevPulse.Api.dll"]
