# DevPulse Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DevPulseDb=Server=(localdb)\mssqllocaldb;Database=DevPulseDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;

# GitHub Personal Access Token (Optional: Increases rate limit from 60 req/hr to 5,000 req/hr)
# Generate from https://github.com/settings/tokens (no special scopes needed for public repo analytics)
GITHUB_TOKEN=

# Docker Compose SQL Server SA Password
MSSQL_SA_PASSWORD=DevPulseStrongPassword123!
